# Copy to .env and fill in the values for this machine. .env is ignored; never commit it.
# Absolute machine paths are operator configuration and must not be committed to portable config.

# Local HIVE API base URL.
HIVE_API_URL=http://127.0.0.1:8000

# HIVE checkout that provides docker-compose.yml and backend/. The installer for a local HIVE
# deployment already exports HIVE_HOME, which scripts/hive_mcp.py also honours, so this value is
# only needed when HIVE lives somewhere the launcher cannot discover.
HIVE_REPO_PATH=

# Docker Compose project owning the api container the MCP launcher should exec into. Leave unset to
# keep the stack the compose file names by default. Set it when a machine runs several HIVE stacks:
# docker compose resolves COMPOSE_PROJECT_NAME ahead of the compose file, so an explicit project is
# the only way to stop the launcher from entering a different stack than the checkout it resolved.
HIVE_COMPOSE_PROJECT=

# This repository's path relative to HIVE's HIVE_PROJECTS_ROOT.
HIVE_ISORYN_RELATIVE_PATH=isoryn-engine

# Optional GEF bootstrap source checkout (for example <projects-root>/gef-bootstrap).
GEF_BOOTSTRAP_REPO_PATH=
